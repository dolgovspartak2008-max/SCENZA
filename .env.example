# Copy this template to .env and fill secrets only on the server.
# Never use VITE_ prefixes for server credentials.

# API and worker must use the SAME persistent directory.
# Use an absolute shared path outside release directories on a server.
SCENA_DATA_DIR=.scena

# Required for automatic video analysis and text editing requests.
OPENROUTER_API_KEY=
# AI work is open only to accounts the owner granted access to. Users are told to ask this Telegram username (without @).
# Empty = SCENZA_BOT.
SCENA_ACCESS_TELEGRAM=

# Leave BOTH empty for the local SQLite video queue.
# Before enabling Supabase, manually apply server/ai/migration.sql.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Required by server/production.mjs for the existing account integration.
SUPABASE_PUBLISHABLE_KEY=

# Leave ALL empty for local object storage under SCENA_DATA_DIR/ai/objects.
# Supply all four required values to enable S3-compatible storage.
# Endpoint must be an HTTPS origin without a bucket path.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Empty = .scena/venv/Scripts/python.exe on Windows, .scena/venv/bin/python on Linux.
# Override with the absolute interpreter path when the environment lives elsewhere.
SCENZA_PYTHON=
SCENZA_WHISPER_MODEL=small
SCENZA_WHISPER_DEVICE=cpu
SCENZA_WHISPER_COMPUTE_TYPE=int8
# Empty = .scena/models in the repository. Use a writable persistent path in production.
SCENZA_WHISPER_CACHE=
# Optional Hugging Face metadata/cache directory; defaults to .scena/huggingface.
# HF_HOME=/absolute/writable/path/huggingface

# Used only by the existing production API entry point.
# Local server/index.mjs listens on 127.0.0.1:5174.
SCENA_PUBLIC_ORIGIN=
SCENA_PORT=5174
SCENA_BOTS_ENABLED=false
PRIMARY_VIDEO_MODEL=google/gemini-3.8-flash
FAST_EDIT_MODEL=google/gemini-3.5-flash-lite
