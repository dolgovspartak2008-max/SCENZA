[Unit]
Description=SCENZA background video worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scenza
Group=scenza
WorkingDirectory=/srv/scenza/current
EnvironmentFile=/srv/scenza/shared/production.env
EnvironmentFile=/srv/scenza/shared/ai.env
Environment=SCENZA_PYTHON=/srv/scenza/shared/venv/bin/python
Environment=SCENZA_WHISPER_CACHE=/srv/scenza/shared/models
Environment=HF_HOME=/srv/scenza/shared/huggingface
Environment=XDG_CACHE_HOME=/srv/scenza/shared/cache
Environment=OMP_NUM_THREADS=3
RuntimeDirectory=scenza-worker
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock --no-fork --nonblock /run/scenza-worker/instance.lock /usr/local/bin/node server/ai/worker.mjs
Restart=on-failure
RestartSec=5
# SIGTERM goes to Node only; Python/FFmpeg keep working while the current job drains.
# Node waits up to 20 min (SCENZA_WORKER_DRAIN_SECONDS, max 1200), then aborts the job, returns it to the queue
# without counting the try and exits (worker.mjs gracefulStop). 1320 s = 1200 drain + 30 abort grace + 60 release + margin;
# SIGKILL is only a last resort if the Node event loop itself is frozen.
KillMode=mixed
TimeoutStopSec=1320
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/scenza/shared /run/scenza-worker
MemoryMax=5G
CPUQuota=300%

[Install]
WantedBy=multi-user.target
